{
  "schema": "stela.config/1",
  "targets": ["x86_64-pc-windows-msvc", "i686-pc-windows-msvc", "aarch64-pc-windows-msvc"],
  "lint": {
    "macroConstants": ["JSI_ABI_POINTER_MASK"]
  },
  "libraries": [
    {
      "name": "sbox",
      "prefix": "sbox",
      "macroPrefix": "SBOX",
      "headers": ["deps/chromium/sandbox_dll/sbox.h"],
      "stelaHeader": "deps/chromium/sandbox_dll/sbox_stela.h"
    },
    {
      "name": "v8host",
      "prefix": "v8host",
      "macroPrefix": "V8HOST",
      "headers": ["src/public/v8host_client.h"],
      "stelaHeader": "src/public/v8host_stela.h"
    },
    {
      "name": "jsi_abi",
      "prefix": "jsi",
      "macroPrefix": "JSI_ABI",
      "headers": ["src/jsi_abi/jsi_abi.h"],
      "includeDirs": ["src"],
      "stelaHeader": "src/jsi_abi/jsi_abi_stela.h"
    },
    {
      "name": "v8_jsi_abi",
      "prefix": "v8_jsi_abi",
      "macroPrefix": "V8_JSI_ABI",
      "headers": ["src/jsi_abi/v8_jsi_abi.h"],
      "includeDirs": ["src"],
      "status": "jsi_status",
      "stelaHeader": false
    },
    {
      "name": "v8_node_api",
      "prefix": "v8_node_api",
      "macroPrefix": "V8_NODE_API",
      "headers": ["src/node-api/v8_node_api.h"],
      "includeDirs": ["src"],
      "status": "napi_status",
      "stelaHeader": "src/node-api/v8_node_api_stela.h"
    }
  ]
}
